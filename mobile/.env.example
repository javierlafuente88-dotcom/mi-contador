# Copia este fichero a .env.local y rellena los valores.
# .env.local NO se sube al repositorio: esta en .gitignore.
#
# Estos dos salen de tu proyecto de Supabase, en Project Settings > API.
# La clave "anon" es publica por diseno: va en la app y la protege RLS.
# La clave "service_role" NUNCA entra aqui ni en el movil. Solo en servidor.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Con esto a "fake" la app usa el almacen local del hito 1 y no necesita
# Supabase para nada. Util para trastear sin cuenta.
EXPO_PUBLIC_DATA_SOURCE=fake
