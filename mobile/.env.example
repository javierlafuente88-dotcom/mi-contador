# Copia este fichero a .env.local y rellena los valores.
# .env.local NO se sube al repositorio: está en .gitignore.
#
# Los valores salen del panel de Supabase, en Settings > API Keys,
# o del botón "Connect" del proyecto, que muestra la URL y la clave juntas.

EXPO_PUBLIC_SUPABASE_URL=

# Clave PUBLICABLE (empieza por sb_publishable_). Es pública por diseño:
# va dentro de la app y lo único que la protege es RLS. Eso es correcto.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Si tu proyecto todavía usa la clave antigua (un JWT largo que empieza por
# eyJ...), ponla aquí en su lugar. Supabase retira anon y service_role a
# finales de 2026, así que lo nuevo es la publicable de arriba.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# La clave SECRETA (sb_secret_... o service_role) NO entra aquí nunca,
# ni en el móvil: se salta todas las políticas de seguridad.

# Con esto en "fake" la app usa el almacén local y no necesita Supabase.
# Útil para trastear sin cuenta. Ponlo en "supabase" cuando esté todo listo.
EXPO_PUBLIC_DATA_SOURCE=fake
